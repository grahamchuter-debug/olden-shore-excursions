{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "olden-bookings-prod",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "olden-bookings-prod",
      "database_id": "b40448d6-016f-4d52-adb3-64225d625671",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PAYMENTS_MODE": "live",
    "BOOKINGS_ENABLED": "false",
    "EMAIL_SENDING_ENABLED": "false",
    "EMAIL_FROM": "bookings@notifications.wowatour.com",
    "EMAIL_FROM_NAME": "Olden Shore Excursions",
    "EMAIL_REPLY_TO": "hello@oldenshoreexcursions.com",
    "CORS_ALLOWED_ORIGINS": "https://oldenshoreexcursions.com,https://www.oldenshoreexcursions.com",
    "SITE_BASE_URL": "https://oldenshoreexcursions.com",
    "ORIGINATING_SITE": "oldenshoreexcursions.com",
    "ORIGINATING_PORT": "Olden, Norway",
    "OPERATOR_PORTAL_BASE_URL": "https://olden-bookings-prod.dark-violet-8d91.workers.dev"
  }
}
